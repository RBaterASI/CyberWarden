# Unreal generated
Binaries/
Intermediate/
Saved/
DerivedDataCache/
# Build/ holds project-owned platform files (icons, entitlements); ignore only generated output
Build/**/Intermediate/
Build/**/Binaries/
Build/**/Staging/
*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# IDE
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.tmp
~$*

# Plugins: ignore only generated output, keep source/content
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Python caches
__pycache__/
*.pyc

# Raw third-party animation downloads (for example Mixamo FBX): never committed. Imported Unreal assets live in Content/ and are tracked.
/ArtSource/Mixamo/

# Artifact Signing (Tools/BuildCpp.ps1): the real signing config lives outside the repository (%LOCALAPPDATA%\CyberWarden\ArtifactSigning) and the script refuses a config inside it.
# State, logs, backups and signing work copies live under Saved/ (ignored above). These patterns are a second line of defence if a config, key material or scratch file is ever
# created inside the repository. Tools/ArtifactSigning.config.example.json (placeholders only) stays tracked.
ArtifactSigning.config.json
ArtifactSigning.local.json
metadata-*.json
*.signing
*.pfx
*.p12
*.snk
